# ── Supabase ─────────────────────────────────────────────────────────────
# Public keys. These are safe to expose in the browser. NEVER put the
# service_role key in any client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Only used inside server-side code (route handlers / server actions).
# Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ────────────────────────────────────────────────────────────────
# Canonical public origin (no trailing slash). Used for sitemap, OG, canonical, emails.
NEXT_PUBLIC_SITE_URL=https://www.sitekoom.com
# Comma-separated list of locales, default first = default locale.
NEXT_PUBLIC_LOCALES=ar,en

# ── Email ───────────────────────────────────────────────────────────────
# Provider: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Sitekoom <no-reply@sitekoom.com>"
# Resend
RESEND_API_KEY=
# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Security ────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the contact API (rate limiting bypass is on us).
# Random string used to sign cookies/CSRF.
AUTH_SECRET=please-change-this-to-a-long-random-string

# ── Screenshots (auto website capture) ──────────────────────────────────
# Chromium is resolved automatically in this order:
#   1) CHROMIUM_EXECUTABLE_PATH  2) system Chrome/Edge/Chromium  3) Playwright Chromium.
# On a Linux server (e.g. Hostinger), run `npx playwright install chromium` once,
# or install Chromium and set the explicit path below.
CHROMIUM_EXECUTABLE_PATH=
